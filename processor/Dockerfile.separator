FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir "audio-separator[cpu]" librosa
RUN mkdir -p /models && audio-separator --model_filename mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt --model_file_dir /models --download_model_only
WORKDIR /app
COPY server.py /app/server.py
ENV PORT=8080 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
ENV SEPARATOR_MODEL=mel_band_roformer_karaoke_aufr33_viperx_sdr_10.1956.ckpt
EXPOSE 8080
CMD ["python", "/app/server.py"]
