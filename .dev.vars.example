# Never commit real values. Configure production values with Wrangler secrets.
SITE_URL=http://localhost:5173
MASTER_ENCRYPTION_KEY=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_PRO=price_replace_me
